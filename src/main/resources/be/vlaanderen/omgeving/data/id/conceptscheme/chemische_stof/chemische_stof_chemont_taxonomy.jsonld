    "graph": [
        {
            "id": "concept:0000000",
            "type": [
                "skos:Concept"
            ],
            "seeAlso": [
                "tax_nodes:C0000000"
            ],
            "skos:altLabel": "Organic Chemicals",
            "broader": "concept:9999999",
            "broaderTransitive": [
                "concept:9999999"
            ],
            "skos:definition": "Compounds that contain at least carbon atom, excluding isocyanide/cyanide and their non-hydrocarbyl derivatives, thiophosgene, carbon diselenide, carbon monosulfide, carbon disulfide, carbon subsulfide, carbon monoxide, carbon trioxide, Carbon suboxide, and dicarbon monoxide.",
            "definition_en": "Compounds that contain at least one carbon atom, excluding isocyanide/cyanide and their non-hydrocarbyl derivatives, thiophosgene, carbon diselenide, carbon monosulfide, carbon disulfide, carbon subsulfide, carbon monoxide, carbon dioxide, Carbon suboxide, and dicarbon monoxide.",
            "inScheme": [
