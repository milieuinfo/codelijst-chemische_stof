    skos:altLabel "Taxane and Abeotaxane diterpenoids", "taxane diterpenoid";
    skos:broader chemische_stof:0001551;
    skos:broaderTransitive chemische_stof:0000000, chemische_stof:0000012, chemische_stof:0000259, chemische_stof:0001551, chemische_stof:9999999;
    skos:definition "Diterpenoids with a structure based either on the taxane skeleton, or a derivative thereof. In term of phytochemistry, several derivatives of the taxane skeleton exist: 2(3->20)-abeotaxane, 3,11-cyclotaxane, 11(15->1),11(10->9)-abeotaxane, 3,8-seco-taxane, and 11(15->1)-abeotaxane, among others. More complex skeletons have been found recently, which include the taxane-derived [3.3.3] propellane ring system.", "Diterpenoids with a structure based either on the taxane skeleton, or a derivative thereof. In term of phytochemistry, several derivatives of the taxane skeleton exist: 2(3->20)-abeotaxane, 3,11-cyclotaxane, 11(15->1),11(10->9)-abeotaxane, 3,8-seco-taxane, and 11(15->1)-abeotaxane, among others. More complex skeletons have been found recently, which include the taxane-derived [3.3.3] propellane ring system."@en;
    skos:inScheme conceptscheme:chemische_stof;
    skos:narrower chemische_stof:RCINICONZNJXQF-VAZQATRQSA-N, chemische_stof:ZDZOTLJHXYCWBA-VCVYQWHSSA-N;
